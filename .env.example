# Copy to .env and fill in. Never commit .env.
TOOLAPP_DB_DRIVER={ODBC Driver 18 for SQL Server}
TOOLAPP_DB_SERVER=your-server.database.windows.net
TOOLAPP_DB_NAME=toolsappdb
TOOLAPP_DB_USER=
TOOLAPP_DB_PASSWORD=
TOOLAPP_SECRET_KEY=generate-with: python -c "import secrets;print(secrets.token_hex(32))"
